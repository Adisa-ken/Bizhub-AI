# GEMINI_API_KEY: Required for Gemini AI Research Copilot calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional signing key for user session tokens (defaults to ephemeral CSPRNG key in memory).
SESSION_SECRET=""

# ADMIN_PASSCODE: Optional passcode for claiming administrator access on the first run.
ADMIN_PASSCODE=""
